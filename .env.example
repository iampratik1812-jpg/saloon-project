# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# (Optional) Supabase integration configuration
# If connecting an external managed Supabase instance:
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"

# (Optional) Payment Gateway (e.g., Razorpay / Cashfree)
# When empty, online payment is safely disabled in favor of "Pay at Salon".
# PAYMENT_GATEWAY_KEY=""

